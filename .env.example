# A local secret is generated during setup. Use a new secret for production.
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# PostgreSQL settings are read from the root .env used by Docker Compose.
# For a different database, set DATABASE_URL here instead.
# DATABASE_URL=postgresql://user:password@localhost:5432/api_mirror
