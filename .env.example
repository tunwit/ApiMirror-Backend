NODE_ENV=production
PORT=3001
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=apimirror
POSTGRES_PASSWORD=replace-with-the-same-password-as-root-env
POSTGRES_DB=apimirror
# Leave empty to use POSTGRES_* above.
DATABASE_URL=
# Use a random secret of at least 32 characters.
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3001
PLAYGROUND_URL=http://localhost:3002
FRONTEND_URL=http://localhost:3000

